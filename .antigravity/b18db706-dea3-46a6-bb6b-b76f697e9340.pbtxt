            }
            lines {
              text: "  const handleRollback = () => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (!canApprove) return;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    setRollbackSuccess(true);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    setExceptions(initialExceptions);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    setTimeout(() => setRollbackSuccess(false), 3000);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
