    content: "\n  // 60-Second Guided Demo State Machine\n  const startGuidedDemo = () => {\n    setDemoStep(1);\n    setActiveTab(\'reconciliation\');\n  };\n\n  const advanceDemo = () => {\n    if (demoStep === 1) {\n      setDemoStep(2);\n      handleRunClose();\n    } else if (demoStep === 2) {\n      setDemoStep(3);\n      setActiveTab(\'exceptions\');\n    } else if (demoStep === 3) {\n      handleApproveAllExceptions();\n      setDemoStep(4);\n      setActiveTab(\'verification\');\n    } else if (demoStep === 4) {\n      setDemoStep(5);\n      setActiveTab(\'memo\');\n    } else {\n      setDemoStep(null);\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#090b0e] text-slate-100 flex flex-col font-sans\">\n      {/* 1. TOP BAR */}\n      <header className=\"border-b border-neutral-800 bg-[#0c0f16] px-6 py-3.5 sticky top-0 z-40\">\n        <div className=\"max-w-7xl mx-auto flex items-center justify-between gap-6\">"
