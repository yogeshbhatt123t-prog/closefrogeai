              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "CREATE INDEX ON knowledge_base USING ivfflat (embedding vector_cosine_ops);`}"
