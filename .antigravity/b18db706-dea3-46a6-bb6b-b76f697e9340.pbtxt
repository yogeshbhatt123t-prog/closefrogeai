            }
            lines {
              text: "## 2. Deterministic Accounting Invariants (Evaluated in Code)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "Unlike probabilistic text generation, financial close requires strict mathematical determinism:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **Double-Entry Invariant:**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   $$\\sum \\text{Debits} \\equiv \\sum \\text{Credits}$$"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   Evaluated with zero decimal tolerance across all journal lines in the trial balance."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Balance Sheet Equation:**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   $$\\text{Total Assets} \\equiv \\text{Total Liabilities} + \\text{Total Equity}$$"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   Evaluated after rolling closed Net Income into Accumulated Deficit."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **ASC 340-40 Capitalization & Amortization:**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   Sales commissions are capitalized on the Balance Sheet as contract acquisition assets and amortized straight-line over contract life (36 months)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "4. **Subledger to General Ledger Tie-Out:**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   Bank statement verified depository cash balance must tie exactly to General Ledger Cash Account #1010."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "5. **Zero Suspense Balance & Duplicate Detection:**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   Account #9999 (Suspense) ending balance must equal $0.00, and transaction SHA-256 hashing verifies zero duplicate entries."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
