      thinking_signature: "\022\374\023\n\371\023\001i\024}\023d\030\264\016O\247\327\376\316X)L6\3374\206\311\277\33627D\325\247\353\222\fkf\276\360$\331\a-\316\312 \223\214\304\212J\222hf7\364\025OC\373*\363V\352\216\335]\316\334\242\271\303\252\'M\371w\274\273\346Rq9T\246\215\323\211#X\327)\227\323sY$>\275\363\374\357\350\311[\023\266 \236\223\341\263\260$F\2637\207v\313^#\0340\370\004\332\271M\363I+\r}[\266\354\350 \324\v?\212\027\265>\217T\254\335=hp\035Y7\257S\344M\343\372\b\026u\365\3222\231>\247\210\265\301\221\323\347\222\374\342]x\243F\266\253\004\022(\030\252\357]\bb\323\271.9Ot\232\363\271\035\314\353\341\257\270NS\313\350\341\365\216Y\366\263\357\265\0347\362\362{\357*\373\242\001\336D\031~\200S\t\305s\320\212\274\264\211\266\177\201\n\223\237A>\203\3419\244\031r\343\236L\362o\357\024\025\226\223\244\363H\203\037>\213\273\223\223\213g\000\aG\230yc\342\237\005\021\f\277Y\226f%3`\367\025I\305I\"\311\236\273\232\025\005\252\"\204=\216\274\320\206\247,~\253\'\267\227,\006tmZT\245\375\003\323\227\366F\251\252\364\032\347\340`\200^N\352\262BX\260\016wx\204\000\260\231\v\b\377\332\b\333\324y\335\373+\003\364\003\241\r\000\206\347\241\362\t\227\346\265\372\016\247\336\b\357\214mK\362\227\035\245&\225\005\234Z\371C\035%%R\001;*\253+\246\027\346#\245Ts\302Nl\336\2112\325\347\242\327(b\316\310\n=\322ML\217\311m2\362,\351\016\331p\235\365\270b4W\350\305S\243@\247\311\243\306|;\312\264w\220\204\371\210\341\363.^\333\177B\305\361E0\234\r\315\244E\357\340\355\262\033\000\177B\035\b\002\273eu\325t\254\3038TQ\361\340\377o\b\376\377H<\003\307\225\253\2138,\300\315|<\322\261\tZ\000}\017\034\215h\373q\233b\361N\352\357\370k\277\223=\312pe\nG\006\021\250\331\020\371\273\331\336C&\377\240\236\224\206\277\316\266e\301\352\376F(\216{\221J\262\230p57k\227\030\227\372\261\233\361\240/i\035\221x\031>|x\302t\376y/8\002\206\300\002\276\324\276\235A$\377=O2\271\003#Yw\023^\264\221\330\244f]\372\326\255\006\211z\002W.\204\t\270\3179\034\311r\324&\020\023\'\356h\276\322z\005v\311\016\227\371\357\257\315\021\217\t\332\036\333\311\017w\324-K\264\343\276p\000\221*\312u46\254(:\376P\031_\375\346\220\205\356\357\317\223\3279\034q\2137T\273\202\336\241w\250\222|h\216\327j\005=\030\003F>\342;\200\324\235\323\265\231\023\022\223}\001\376\300\0333\373\347\377\303I?t\236\371z\344$\211/~\303\316\333\270\347\331H\324\000\357\205\350\252\216\320S\f\302\332\266\005\336\251S\265\222\003\024&\242\252\322\320\372\n\244\341\037\263\277\263\255\212\275\327\353+\324\005\b\254\377\345\n\243\2752\207\221gr\\\2639\230\250\354\312&\220T4\000\265A\2615\315\2560\332\000l\002O\020s\344\320\025+\221\213o\\\333\034\f\305)\316Jo\va\356F\276\332\252\354!\376\227\232\324K\256\323&\225&\206\236}\351[l\325u\314\026\266DIv#\275}\036\332&v\216\257N\203BF\035\214|\270\031$\272\260\364\355}\205\035h\343\023{\326|J3\377\237\335\004O\327\201\033z\24513l\027H\340G\271hno\311eA\276?V,\305\341\322\3307r\300\200\307\aq\250f\322\006\206q\374\025\317\370\020\260 \370\2223\317\315\237V\223H_9Z\220lr\225\363\364\344\240\371>\344)\031\376\262)I\037ZlQ\261\226\3761\267b\304\3525)\222G\213b\325\353Wh\227\001Py\245\277\363l\214\301\210\020\275\236\255a9\327{\2557\027\240\352\326\223X%-\330T\361\030\326A\267\247\314\217X\226\317\235\271<&\363\344\' \205\304\237\t\341?v\305c\005\234\2327\242\357\370UJ\330\223\256&\330\212\224\274\245\303\212\334\f\323\017fF\n;\026\355\333Q+\340e\214cXo\" \210\265\237\317\305\324\233A\203#\356\216\343e\035Y\321\016\357Q\253\230\342\371\303\347\241\254\202\233\332\207\342\177\aY\\\240\316\247\230\261nf\002\353\231\213\207\266\3348&w\320\344\225m\353g:\215\356R\025\347\202_\217\277v\216\373\357xB\231\027\307z\317\257\270\250\037\215-\275\304\256`,\177=\252\002\004\276\312*\\\363\f\264c\257\247AD\031@a{U\260\315\273\024D\206\335\211\204q\225\271\'\253\347\340\021\3642.\353\220u\006&\232\207\302\3170\341\203\345\005w\363N\243\"_\032\004Ss\200\302w\232\367\336#\334\no}%^O\233y\2333gc\205\277\342\267\303\213I\345\002\315\327\271\362\'\322/\f\344W\361H\362\230>\2752\331\334\321\004\260:\f1\025i\376@4\274\346\326\030e\215\273\252\332\263u\267y2\227\030\200N\374\">\267j\340\006\037\021)L\232t\022\267\005$V\323-*\f\002\016\316 \311\253\272\220\320e\352n~v\257\026\3371\300\020=\247\225\224\366~W\214_\027\'\351\n\361\207\247:\373\274\000\304\275X\211\362#a\261\203H\250Fw <\300\275\327\337\33177R\252\315\f\f\223\216\275\020)l\227#\335\244\301\350\364Z\235kn\261\365\300\260Px LI\004aR\256MO\312j\206\242\025\375\213JJ\215\307\242Z\276\377\222{Q\271D\344\036fh+\344\303q,\334\005\365\301:\r\n\247E\377\274SH\327\257\331/\267\031ux\372\206\335d-\217OpX\220\375\243\300\251H\037\bX\313\257\001\314\006=\243\227^\v\210|\355\217\357\374\337!\\\277\222\344UK\1770\3765\0014t\304\254\205\003K\246\240\353\'l\3313\345\033\340\331\323\220\016\266\355f9]\031\306\t\213\336o>x\346i\035\024\372a\315\247?Y\315\0010_.\305Nc\001\"\240\243U\004\225\035\271\024\221L\222D\353\346\206\322j\227\020\374\202\273M\233N\224=iK\314\023-\377)\333\325\221\232\254\203\234\363\\\307\263\304\240\353i\035\2628nw\330\244\'\2223&\357,\244sBA5\372\240K:Z\024\033\203\202X7\016\330\367\317v\"\357\004d\017\024\336\263\242\353\347\037-\314Ld\234\263\004\301\247w\222\312\244#\334\353\227A8\216\027P\377\242\353\346T\355!\a\262X\343\266$h\211\310N\277\250[\372!\3619\b\260\343fLc\034\224\330ST\346\2215*\2134\261\240\226\023vKg\333!.\217\261Y;.\304\t\200\322t\247\332\221\302\3033\231\274G\271\227f \362\004\0179\331J\247\374Y\2276$v\273\335\370)c!u\261\240\207\365\020a\023{W\257\033\'h\374\214\336\3522.\332b\022\000\322C\312R[\257=\362m\220\270i\211W\243\334\345\264\305\302\314\234/{\027\224\214(\205<Y\377\357\332\270d7T\"$fO\037\237\364\236\251\260&B\224\270\342\275\'`\320\243\264*T,\240fRw\300qWf\354.u\376\251E\312c\024\025\224\266\216\372\016\234\367\017\025$Z`\301E,\017\006\016\264}X\226H\\\207\312\351EE\257H{\031+7\vo\034\325\025\234i/\361i\260\242\306 HW\257\321Gu\177r\321r\215\361\355\210`I\b\3106\361\217]W\223\024\2356\214\311\'I\035|\216\336\301\345\301\027\360e\237\326b,\251Jy\247b\336o\353\360\363\317r\237^\204h\004\352\261\211\302:\206+\334n\346\204\270\350\247\215\376\005\335\r5\365w\311\032/6G\350N\212\nb{\005\023\212l\363\037:H\261\326\232\370P\372\251\v\350IhS\275 &\373\2476j\342F\257K\005\213=\030\226\213\b\374R+\306Q\243\003$\030i}\360E{\341\332n\321\326t\341\207\341)\242\'{K\204\v=\302\234\003!\357\270\275[\370)gL\355\344+\\q\a\300\267\217\343x\223q\311\001\211\357\025\211/\237\f\247\017|\230\371\267O2\227d\254\004\177\265\335\243b\367\222 \376@V\021c\016\334\037\267)\003)\216\0250\027O\241\251\302\307\334\232\346\353\334\233nJ\316\300^\031\3134:\356\'\313\226\260k\312\366\"\272\273GT\f\264\317\202\"\322\301\004\262\304\001\366\335ny\aX\363\345h\307G\252Wjo.\327\227>n\252M\240\231\023\207\177\032mH\037w\a\340t\375k#\303\'\242\367g\330\376\317Q\322\016&a\200\273V\264\263\t+\3278\260\v(wa]\024\363\230o\325\023\251^\311\224\036\372\360IX\231\r\023\v%\355\346\261h\366\216\236\243\0215T\202\210\233\3168\364dK1\234\371\327H\303.\241BR5\342\333N\340\207\344\271r<\005\214i\261\336\205\224\032\236\354[\221<GN\207\276\032\2472S\245\313\b\357\v\322\327O\315}\302\0375|\206Q\204\332s\357\274\334\307T\025)\312\243\321\350\214\025f\343\272\340 y\361(\206h\251x\242u\327~\244\333\313\205EP\340\316=j\204u\254Aw\210\354\206\373t,\351|\266\256\b\032,\255\374\177\341C\233\225\325\027\264\303\314\344\377@-\211v.\247\215\241\023\203\235$\226\374\313|H\367Z\204\\("
