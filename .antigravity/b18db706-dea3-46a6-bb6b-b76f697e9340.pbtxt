            }
            lines {
              text: "-- 1. Organizations (Tenants)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE TABLE organizations ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    name VARCHAR(255) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    domain VARCHAR(255) NOT NULL UNIQUE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    arr_usd NUMERIC(15, 2) NOT NULL DEFAULT 0.00,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    currency VARCHAR(3) NOT NULL DEFAULT \'USD\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    fiscal_year_end VARCHAR(5) NOT NULL DEFAULT \'12-31\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    accounting_basis VARCHAR(10) NOT NULL DEFAULT \'GAAP\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    pricing_tier VARCHAR(50) NOT NULL DEFAULT \'outcome_based\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    outcome_rate_per_close NUMERIC(10, 2) NOT NULL DEFAULT 1250.00,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- 2. Users with Roles"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE TABLE users ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    org_id UUID NOT NULL REFERENCES organizations(id) ON DELETE CASCADE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    email VARCHAR(255) NOT NULL UNIQUE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    role VARCHAR(50) NOT NULL CHECK (role IN (\'controller\', \'external_auditor\', \'board_observer\')),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    full_name VARCHAR(255) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- 3. Close Jobs (State Machine Instances)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE TABLE jobs ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    org_id UUID NOT NULL REFERENCES organizations(id) ON DELETE CASCADE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    period VARCHAR(50) NOT NULL, -- e.g. \'2026-Q3\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    status VARCHAR(50) NOT NULL CHECK ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        status IN (\'idle\', \'planning\', \'gathering\', \'reconciling\', \'analyzing_variance\', \'drafting_package\', \'self_critiquing\', \'requires_exception_review\', \'completed\', \'failed\')"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    outcome_score NUMERIC(5, 2) DEFAULT 0.00, -- 0 to 100"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    screen_time_saved_hours NUMERIC(6, 2) DEFAULT 0.00,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    outcome_fee_usd NUMERIC(10, 2) DEFAULT 0.00,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    created_by UUID REFERENCES users(id),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    completed_at TIMESTAMPTZ"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- 4. Job Steps (Deterministic Agent Steps & Tool Invocations)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE TABLE job_steps ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    job_id UUID NOT NULL REFERENCES jobs(id) ON DELETE CASCADE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    org_id UUID NOT NULL REFERENCES organizations(id) ON DELETE CASCADE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    step_number INT NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    name VARCHAR(255) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    state VARCHAR(50) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    status VARCHAR(50) NOT NULL CHECK (status IN (\'pending\', \'running\', \'completed\', \'flagged\')),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    duration_ms INT NOT NULL DEFAULT 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tool_invocations JSONB NOT NULL DEFAULT \'[]\'::jsonb,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    reasoning TEXT,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    confidence_score NUMERIC(4, 3) NOT NULL DEFAULT 1.000,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- 5. Files & Uploaded Invoices (Encrypted S3 metadata)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE TABLE files ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    org_id UUID NOT NULL REFERENCES organizations(id) ON DELETE CASCADE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    job_id UUID REFERENCES jobs(id) ON DELETE SET NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    filename VARCHAR(255) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    file_type VARCHAR(50) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    s3_key VARCHAR(512) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    sha256_checksum VARCHAR(64) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    file_size_bytes BIGINT NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    pii_redacted BOOLEAN NOT NULL DEFAULT FALSE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- 6. Immutable Audit Logs (Cryptographically Chained)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE TABLE audit_logs ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    org_id UUID NOT NULL REFERENCES organizations(id) ON DELETE CASCADE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    job_id UUID REFERENCES jobs(id),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    actor_type VARCHAR(50) NOT NULL CHECK (actor_type IN (\'agent\', \'user\', \'system\')),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    actor_id VARCHAR(255),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    action VARCHAR(100) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    tool_called VARCHAR(100),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    details JSONB NOT NULL DEFAULT \'{}\'::jsonb,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    previous_hash VARCHAR(64),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    current_hash VARCHAR(64) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- 7. Outcome Billing Events"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE TABLE billing_events ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    org_id UUID NOT NULL REFERENCES organizations(id) ON DELETE CASCADE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    job_id UUID NOT NULL REFERENCES jobs(id),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
