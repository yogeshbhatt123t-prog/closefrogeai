      thinking_signature: "\022\317\022\n\314\022\001i\024}\023q]\030\r\200\225\253-\350w\251\376\361\231[\024\265\224s\255\200\020s\360F|\037\r\204\fJ\212z\"(\271\320\355\301\316\332\347\237{\025g\246L\023\366\321{Z\203\003\242`\336Ik\204\304\334|\215\332\"\026\t\002\245\325}W<\'\322\377=\224\323\036#d\343\325\245\271zw\204\245\345\022\345C\211\262@k\324w\260\235\324=\261\223\355\341\034\356w\331\311\031\002\222 \274 \355%1\246\344\266\177\fF\a\3279\253\354\202\250\036Q\234\177MhQ\005\252c\b\307\323\023\325mh\224}\264\b\351\302\240\252\376\001\2145e\272\224\247F7\252U\265\321\343\2715{>W\300ME\371)\257\2234\220\027\336\263\016\000I\bzk9\301@n\026\200\316\003\245\023\237\200Y\016\237/\220t\254e\304\302\032\365F\025`\264\366:\347\303v\215\201:\313\261\003\301|\250s9\235,O{\303\v\307\244\245!\200\311\276I\324\002\202\202\353\027+\211\341MNS4TM\335\327\213e\326:&\255(\347\325\326_!W84$>\2057\351\b\351\251\351\231\023\260s;\244\365\206\216\331\372\000@\004\207\272\254\201\256\365N\351~\350\255\036\377\351\356\202\331\276\317\314j\376\270\016\017\252\003 \346\210\270\247*\224\2072\a\026P0~6\255k\322{0t\374d\001\366\232*>;\245$\213\3154$\350\263\307\316\252QV\333!\320{\377\225\017\307\211:#yq\277\336\355zS\016\247\357\317El\306\v\277\340\232\200\304:B\373\357{\2310l\240\265\356R\352Mg\250\213@w\306\216\270\324\303\371q\323\355\274\313v(\261~\266\002}&i\234\336\3302\260\363\'\002\"\240\327%\034\330\252}\006\340\207\037\301f\021\022\361\353\217\216_{\303\035y\240\230\256\022\311M\202\232#\241\356\341\033\200\366\260FC\021G\363\233/\273\374\216!*R\032\367\231\020NN\004\374\005\265\310:m\204\a6i\276L_r,\265\303\203\312\310HO\205\235N\221?\004KT\275\233\257\025\365\376j?A\345\241@\217\201OZ\260\247\304\021\037\301j\375\302\353\267i\355\034\344b#h\003]v\324\346@\026\035\215\211oc\264\331+\257\230i\253\312\272k\234\203T\321a\217\025\243&5\3207\026\a#\303\024\312Mn\327\232\215\256\241\364\276}\265\031\245Q\340\311n\270\025\240\2631\275\311C&\373\245\271\263\320\361\323\362@g\022\