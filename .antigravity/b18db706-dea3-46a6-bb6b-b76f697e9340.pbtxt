            lines {
              text: "  const intersection = new Set([...tokens1].filter(x => tokens2.has(x)));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const union = new Set([...tokens1, ...tokens2]);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (union.size === 0) return 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return intersection.size / union.size;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
