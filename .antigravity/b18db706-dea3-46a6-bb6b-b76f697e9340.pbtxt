              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- 8. Knowledge Base & Accounting Policies with pgvector"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE TABLE knowledge_base ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    org_id UUID NOT NULL REFERENCES organizations(id) ON DELETE CASCADE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    title VARCHAR(255) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    category VARCHAR(50) NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    content TEXT NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    embedding vector(1536), -- compatible with text-embedding models"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Vector Cosine Indexing"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE INDEX IF NOT EXISTS knowledge_base_embedding_idx "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "ON knowledge_base "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "USING ivfflat (embedding vector_cosine_ops) "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "WITH (lists = 100);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Enable Row-Level Security (RLS) on all multi-tenant tables"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "ALTER TABLE organizations ENABLE ROW LEVEL SECURITY;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "ALTER TABLE users ENABLE ROW LEVEL SECURITY;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "ALTER TABLE jobs ENABLE ROW LEVEL SECURITY;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "ALTER TABLE job_steps ENABLE ROW LEVEL SECURITY;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "ALTER TABLE files ENABLE ROW LEVEL SECURITY;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "ALTER TABLE audit_logs ENABLE ROW LEVEL SECURITY;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "ALTER TABLE billing_events ENABLE ROW LEVEL SECURITY;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "ALTER TABLE knowledge_base ENABLE ROW LEVEL SECURITY;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Example RLS Policy enforcing tenant isolation via session setting"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE POLICY tenant_isolation_policy_jobs ON jobs"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    USING (org_id = current_setting(\'app.current_org_id\')::uuid);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE POLICY tenant_isolation_policy_files ON files"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    USING (org_id = current_setting(\'app.current_org_id\')::uuid);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE POLICY tenant_isolation_policy_audit ON audit_logs"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    USING (org_id = current_setting(\'app.current_org_id\')::uuid);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE POLICY tenant_isolation_policy_kb ON knowledge_base"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    USING (org_id = current_setting(\'app.current_org_id\')::uuid);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "```"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
