              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                <p>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                  Working prototype ready for design partner pilots. <strong>The Ask:</strong> 3 mid-market SaaS design partner pilots ($5M-$25M ARR) to run parallel Q4 closes, and pre-seed backing to scale ERP connectors."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
