    content: "export type CloseJobStatus = \n  | \'idle\' \n  | \'planning\' \n  | \'gathering\' \n  | \'reconciling\' \n  | \'analyzing_variance\' \n  | \'drafting_package\' \n  | \'self_critiquing\' \n  | \'requires_exception_review\'\n  | \'completed\' \n  | \'failed\';\n\nexport type UserRole = \'controller\' | \'external_auditor\' | \'board_observer\';\n\nexport interface Organization {\n  id: string;\n  name: string;\n  domain: string;\n  arr_usd: number;\n  currency: string;\n  fiscal_year_end: string;\n  accounting_basis: \'GAAP\' | \'IFRS\';\n  pricing_tier: \'outcome_based\';\n  outcome_rate_per_close: number;\n}\n\nexport interface JobStep {\n  id: string;\n  step_number: number;\n  name: string;\n  state: CloseJobStatus;\n  status: \'pending\' | \'running\' | \'completed\' | \'flagged\';\n  duration_ms: number;\n  tool_invocations: Array<{\n    tool: string;\n    input: Record<string, any>;\n    output: Record<string, any>;\n    status: \'success\' | \'warn\' | \'error\';\n  }>;\n  reasoning: string;\n  confidence_score: number; // 0.0 to 1.0\n  created_at: string;\n}\n\nexport interface FinancialMetric {\n  name: string;\n  current_period: number;\n  prior_period: number;\n  budget: number;\n  variance_pct: number;\n  variance_usd: number;\n  status: \'favorable\' | \'unfavorable\' | \'neutral\';\n  commentary?: string;\n}\n\nexport interface VarianceItem {\n  id: string;\n  account_code: string;\n  account_name: string;\n  category: \'Revenue\' | \'COGS\' | \'R&D\' | \'S&M\' | \'G&A\';\n  actual_amount: number;\n  budget_amount: number;\n  prior_amount: number;\n  variance_amount: number;\n  variance_pct: number;\n  materiality: \'high\' | \'medium\' | \'low\';\n  ai_analysis: string;\n  flagged_for_exception: boolean;\n}\n\nexport interface ExceptionItem {\n  id: string;\n  title: string;\n  source: \'Stripe\' | \'Silicon Valley Bank\' | \'Brex\' | \'NetSuite\' | \'Gusto\';\n  amount: number;\n  confidence: number;\n  detected_anomaly: string;\n  suggested_action: string;\n  resolved: boolean;\n  resolution_note?: string;\n  resolved_by?: string;\n}\n\nexport interface ASC606Waterfall {\n  month: string;\n  beginning_deferred_revenue: number;\n  new_billings: number;\n  recognized_revenue: number;\n  ending_deferred_revenue: number;\n}\n\nexport interface ClosePackage {\n  period: string; // e.g. \"Q3 2026 (July - September)\"\n  company_name: string;\n  arr: number;\n  mrr: number;\n  net_retention_rate: number;\n  gross_margin_pct: number;\n  burn_multiple: number;\n  cash_balance: number;"
