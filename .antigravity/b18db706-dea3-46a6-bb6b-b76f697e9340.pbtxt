              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const newClosing = item.capitalized_commission - (item.prior_accumulated_amort + monthlyAmort);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    total_capitalized += item.capitalized_commission;"
