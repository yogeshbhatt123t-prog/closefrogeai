        instruction: "import React from \'react\';\nimport { ClosePackage } from \'../types/finance.ts\';\nimport { Clock, CheckCircle2, TrendingUp, DollarSign, Shield } from \'lucide-react\';\n\ninterface OutcomeKpiStripProps {\n  pkg: ClosePackage;\n  isRunning: boolean;\n}\n\nexport const OutcomeKpiStrip: React.FC<OutcomeKpiStripProps> = ({ pkg, isRunning }) => {\n  return (\n    <div className=\"grid grid-cols-2 md:grid-cols-5 gap-3 mb-6\">\n      {/* Metric 1: Outcome Score */}\n      <div className=\"bg-[#0f131c] border border-neutral-800/80 rounded-lg p-3.5 flex flex-col justify-between\">\n        <div className=\"flex items-center justify-between text-xs text-slate-400 mb-1\">\n          <span>Outcome Score</span>\n          <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-400\" />\n        </div>\n        <div className=\"flex items-baseline gap-1.5\">\n          <span className=\"text-2xl font-bold font-mono text-white tabular-nums\">\n            {isRunning ? \'\342\200\224\' : `${pkg.outcome_score.toFixed(1)}`}\n          </span>\n          <span className=\"text-xs text-slate-400 font-mono\">/ 100</span>\n        </div>\n        <div className=\"text-[11px] text-emerald-400/90 mt-1 flex items-center gap-1 font-mono\">\n          <span>14/14 GAAP Invariants</span>\n        </div>\n      </div>\n\n      {/* Metric 2: Screen Time Saved */}\n      <div className=\"bg-[#0f131c] border border-neutral-800/80 rounded-lg p-3.5 flex flex-col justify-between\">\n        <div className=\"flex items-center justify-between text-xs text-slate-400 mb-1\">\n          <span>Screen Time Saved</span>\n          <Clock className=\"w-3.5 h-3.5 text-cyan-400\" />\n        </div>\n        <div className=\"flex items-baseline gap-1.5\">\n          <span className=\"text-2xl font-bold font-mono text-white tabular-nums\">\n            {isRunning ? \'...\' : `${pkg.screen_time_saved_hours}h`}\n          </span>\n        </div>\n        <div className=\"text-[11px] text-slate-400 mt-1 font-mono\">\n          <span>Zero manual entry</span>\n        </div>\n      </div>\n\n      {/* Metric 3: Outcome-Based Price */}\n      <div className=\"bg-[#0f131c] border border-neutral-800/80 rounded-lg p-3.5 flex flex-col justify-between\">\n        <div className=\"flex items-center justify-between text-xs text-slate-400 mb-1\">\n          <span>Outcome Billing Fee</span>\n          <DollarSign className=\"w-3.5 h-3.5 text-emerald-400\" />\n        </div>\n        <div className=\"flex items-baseline gap-1.5\">\n          <span className=\"text-2xl font-bold font-mono text-emerald-400 tabular-nums\">\n            ${pkg.outcome_based_fee_usd.toLocaleString()}\n          </span>\n        </div>\n        <div className=\"text-[11px] text-slate-400 mt-1 font-mono line-through\">\n          Legacy: ${pkg.legacy_manual_cost_usd.toLocaleString()}\n        </div>\n      </div>\n\n      {/* Metric 4: Annual Run Rate (ARR) & Growth */}\n      <div className=\"bg-[#0f131c] border border-neutral-800/80 rounded-lg p-3.5 flex flex-col justify-between\">\n        <div className=\"flex items-center justify-between text-xs text-slate-400 mb-1\">\n          <span>Verified ARR (Q3)</span>\n          <TrendingUp className=\"w-3.5 h-3.5 text-indigo-400\" />\n        </div>\n        <div className=\"flex items-baseline gap-1.5\">\n          <span className=\"text-2xl font-bold font-mono text-white tabular-nums\">\n            ${(pkg.arr / 1000000).toFixed(1)}M\n          </span>\n          <span className=\"text-xs text-emerald-400 font-mono\">+11.9% QoQ</span>\n        </div>\n        <div className=\"text-[11px] text-slate-400 mt-1 font-mono\">\n          <span>NDR: {pkg.net_retention_rate}%</span>\n        </div>\n      </div>\n\n      {/* Metric 5: Cash Balance & Runway */}\n      <div className=\"bg-[#0f131c] border border-neutral-800/80 rounded-lg p-3.5 flex flex-col justify-between col-span-2 md:col-span-1\">\n        <div className=\"flex items-center justify-between text-xs text-slate-400 mb-1\">\n          <span>Cash Runway</span>\n          <Shield className=\"w-3.5 h-3.5 text-amber-400\" />\n        </div>\n        <div className=\"flex items-baseline gap-1.5\">\n          <span className=\"text-2xl font-bold font-mono text-white tabular-nums\">\n            {pkg.runway_months.toFixed(1)} mo\n          </span>\n        </div>\n        <div className=\"text-[11px] text-slate-400 mt-1 font-mono\">\n          ${(pkg.cash_balance / 1000000).toFixed(2)}M at SVB\n        </div>\n      </div>\n    </div>\n  );\n};\n"
