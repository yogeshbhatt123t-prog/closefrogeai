              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    embedding vector(1536) -- Company-specific accounting policies"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
