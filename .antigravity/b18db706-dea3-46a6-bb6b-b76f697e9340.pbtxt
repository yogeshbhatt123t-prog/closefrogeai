  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { JobStep, CloseJobStatus } from \'../types/finance.ts\';\nimport { CheckCircle2, CircleDashed, AlertTriangle, Terminal, ChevronDown, ChevronUp } from \'lucide-react\';\n\ninterface AgentProgressStepperProps {\n  currentStatus: CloseJobStatus;\n  progressPct: number;\n  steps: JobStep[];\n  isRunning: boolean;\n}\n\nexport const AgentProgressStepper: React.FC<AgentProgressStepperProps> = ({\n  currentStatus,\n  progressPct,\n  steps,\n  isRunning,\n}) => {\n  const [expandedStepId, setExpandedStepId] = React.useState<string | null>(null);\n\n  const toggleExpand = (id: string) => {\n    setExpandedStepId(expandedStepId === id ? null : id);\n  };\n\n  return (\n    <div className=\"bg-[#0f131c] border border-neutral-800 rounded-lg p-5 mb-6\">\n      {/* Header with overall progress bar */}\n      <div className=\"flex items-center justify-between gap-4 mb-3\">\n        <div>\n          <div className=\"text-xs font-semibold text-slate-200 flex items-center gap-2\">\n            <span>Agentic Orchestration Loop</span>\n            <span className=\"text-slate-500\">\302\267</span>\n            <span className=\"text-xs text-slate-400 font-normal\">State Machine Execution</span>\n          </div>\n          <div className=\"text-[11px] text-slate-400 mt-0.5 font-mono\">\n            Status: <span className=\"text-emerald-400 uppercase font-semibold\">{currentStatus.replace(\'_\', \' \')}</span>\n          </div>\n        </div>\n\n        <div className=\"text-right\">\n          <span className=\"text-xs font-mono font-bold text-slate-200 tabular-nums\">{progressPct}%</span>\n          <div className=\"w-28 sm:w-40 bg-neutral-800 h-1.5 rounded-full mt-1 overflow-hidden\">\n            <div\n              className=\"bg-emerald-400 h-full rounded-full transition-all duration-500 ease-out\"\n              style={{ width: `${progressPct}%` }}\n            />\n          </div>\n        </div>\n      </div>\n\n      {/* Steps List */}\n      <div className=\"space-y-2 mt-4\">\n        {steps.map((step) => {\n          const isCompleted = step.status === \'completed\';\n          const isFlagged = step.status === \'warn\' || step.status === \'flagged\';\n          const isExpanded = expandedStepId === step.id;\n\n          return (\n            <div\n              key={step.id}\n              className={`border rounded-md transition-colors ${\n                isCompleted\n                  ? \'border-neutral-800 bg-[#121622]/60\'\n                  : isFlagged\n                  ? \'border-amber-900/50 bg-amber-950/20\'\n                  : \'border-neutral-800/40 bg-[#0d1017]/40\'\n              }`}\n            >\n              <div\n                onClick={() => toggleExpand(step.id)}\n                className=\"px-3.5 py-2.5 flex items-center justify-between cursor-pointer select-none\"\n              >\n                <div className=\"flex items-center gap-3\">\n                  {isCompleted ? (\n                    <CheckCircle2 className=\"w-4 h-4 text-emerald-400 shrink-0\" />\n                  ) : isFlagged ? (\n                    <AlertTriangle className=\"w-4 h-4 text-amber-400 shrink-0\" />\n                  ) : (\n                    <CircleDashed className=\"w-4 h-4 text-slate-500 shrink-0 animate-spin\" />\n                  )}\n\n                  <div className=\"flex flex-col sm:flex-row sm:items-center sm:gap-3\">\n                    <span className=\"text-xs font-medium text-slate-200\">\n                      {step.step_number}. {step.name}\n                    </span>\n                    <span className=\"text-[11px] text-slate-400 hidden sm:inline\">\n                      {step.reasoning.slice(0, 75)}...\n                    </span>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-3 shrink-0\">\n                  <span className=\"text-[10px] font-mono text-slate-400 tabular-nums\">\n                    {step.duration_ms}ms \302\267 Conf: {(step.confidence_score * 100).toFixed(0)}%\n                  </span>\n                  {isExpanded ? (\n                    <ChevronUp className=\"w-3.5 h-3.5 text-slate-400\" />\n                  ) : (\n                    <ChevronDown className=\"w-3.5 h-3.5 text-slate-400\" />\n                  )}\n                </div>\n              </div>\n\n              {/* Expanded details: Reasoning & Tool Invocations */}\n              {isExpanded && (\n                <div className=\"px-3.5 pb-3 pt-1 border-t border-neutral-800/60 text-xs\">\n                  <div className=\"mb-2\">\n                    <span className=\"text-[10px] uppercase font-mono tracking-wider text-slate-400\">Agent Reasoning:</span>\n                    <p className=\"text-slate-300 mt-0.5 leading-relaxed font-sans\">{step.reasoning}</p>\n                  </div>\n\n                  {step.tool_invocations && step.tool_invocations.length > 0 && (\n                    <div className=\"mt-2 space-y-1.5\">\n                      <span className=\"text-[10px] uppercase font-mono tracking-wider text-slate-400 flex items-center gap-1\">\n                        <Terminal className=\"w-3 h-3 text-emerald-400\" />\n                        Tool Invocations & Verified Sandbox Execution:\n                      </span>\n                      {step.tool_invocations.map((t, idx) => (\n                        <div\n                          key={idx}\n                          className=\"bg-[#0a0d14] border border-neutral-800/80 rounded p-2 font-mono text-[11px]\"\n                        >\n                          <div className=\"flex items-center justify-between text-emerald-400 mb-1\">\n                            <span className=\"font-semibold\">{t.tool}()</span>\n                            <span className={`text-[10px] uppercase px-1 rounded ${\n                              t.status === \'success\' ? \'text-emerald-400 bg-emerald-950/40\' : \'text-amber-400 bg-amber-950/40\'\n                            }`}>\n                              {t.status}\n                            </span>\n                          </div>\n                          <div className=\"text-slate-400 text-[10px] grid grid-cols-1 md:grid-cols-2 gap-2 mt-1\">\n                            <div>\n                              <span className=\"text-slate-500\">Args: </span>\n                              {JSON.stringify(t.input)}\n                            </div>\n                            <div>\n                              <span className=\"text-slate-500\">Result: </span>\n                              {JSON.stringify(t.output)}\n                            </div>\n                          </div>\n                        </div>\n                      ))}\n                    </div>\n                  )}\n                </div>\n              )}\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/AgentProgressStepper.tsx"
        }
        overwrite: true
      }
    }
