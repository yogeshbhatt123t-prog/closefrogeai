    content: "    URL.revokeObjectURL(url);\n  };\n\n  // Handler: Rollback state\n  const handleRollback = () => {\n    if (!canApprove) return;\n    setRollbackSuccess(true);\n    setExceptions(initialExceptions);\n    setTimeout(() => setRollbackSuccess(false), 3000);\n  };\n\n  // 60-Second Guided Demo State Machine\n  const startGuidedDemo = () => {\n    setDemoStep(1);\n    setActiveTab(\'reconciliation\');\n  };\n\n  const advanceDemo = () => {\n    if (demoStep === 1) {\n      setDemoStep(2);\n      handleRunClose();\n    } else if (demoStep === 2) {\n      setDemoStep(3);\n      setActiveTab(\'exceptions\');\n    } else if (demoStep === 3) {\n      handleApproveAllExceptions();\n      setDemoStep(4);\n      setActiveTab(\'verification\');\n    } else if (demoStep === 4) {\n      setDemoStep(5);\n      setActiveTab(\'memo\');\n    } else {\n      setDemoStep(null);\n    }\n  };\n"
    num_lines: 2902
    num_bytes: 149821
    line_range_bytes: 843
  }
