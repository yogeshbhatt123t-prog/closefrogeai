              text: "              <div>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                <h4 className=\"font-bold text-white text-sm mb-1\">4. Target Customer & Wedge</h4>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                <p>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                  Mid-market SaaS ($5M-$100M ARR) using Stripe + NetSuite/QuickBooks + SVB/Mercury. The wedge is the month-end close package and one-page board summary memo. Once we reconcile the ledger, we own the financial system of truth."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                </p>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              </div>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
