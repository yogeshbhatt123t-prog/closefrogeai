        replacement_content: "JE-GL-004,2026-09-30,7010,Rent & Facilities,28500.00,0.00,US-CORP,WeWork office lease\nJE-GL-004,2026-09-30,1010,Operating Cash,0.00,28500.00,US-CORP,Lease payment`;\n\nexport interface CsvPreviewData {\n  fileName: string;\n  totalRowCount: number;\n  headers: string[];\n  rows: string[][];\n  sourceType: \'bank\' | \'gl\';\n}\n\nfunction parseCsvToPreview(fileName: string, csvText: string, sourceType: \'bank\' | \'gl\'): CsvPreviewData {\n  const lines = csvText.split(/\\r?\\n/).map(l => l.trim()).filter(l => l.length > 0);\n  if (lines.length === 0) {\n    return { fileName, totalRowCount: 0, headers: [], rows: [], sourceType };\n  }\n\n  const parseLine = (line: string): string[] => {\n    const fields: string[] = [];\n    let cur = \'\';\n    let inQuotes = false;\n    for (let i = 0; i < line.length; i++) {\n      const c = line[i];\n      if (c === \'\"\') {\n        inQuotes = !inQuotes;\n      } else if (c === \',\' && !inQuotes) {\n        fields.push(cur.trim());\n        cur = \'\';\n      } else {\n        cur += c;\n      }\n    }\n    fields.push(cur.trim());\n    return fields;\n  };\n\n  const headers = parseLine(lines[0]);\n  const rows = lines.slice(1, 6).map(parseLine);\n  const totalRowCount = Math.max(0, lines.length - 1);\n\n  return {\n    fileName,\n    totalRowCount,\n    headers,\n    rows,\n    sourceType,\n  };\n}\n\nexport default function App() {"
        start_line: 449
