            lines {
              text: "## 2. Complete PostgreSQL Schema with Row-Level Security (RLS)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "```sql"
