              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function calculateDaysToClose(manualBaselineDays: number = 14): DaysToCloseScoreboard {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const frogeclose_days = 0.06; // ~1.5 hours"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const days_saved = Math.max(0, manualBaselineDays - frogeclose_days);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const speedup_factor = Math.round((manualBaselineDays / frogeclose_days) * 10) / 10;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Finance team hours saved: ~8 hours per day saved"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const hours_saved_monthly = Math.round(days_saved * 8);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const blended_hourly_rate = 95.00; // Blended CPA/Sr Accountant hourly rate"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const monthly_labor_saved = Math.round(hours_saved_monthly * blended_hourly_rate);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const annual_roi = Math.round((monthly_labor_saved * 12) - (1250 * 12)); // net of FrogeClose fee"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    manual_baseline_days: manualBaselineDays,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    frogeclose_current_days: frogeclose_days,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    days_saved: Math.round(days_saved * 10) / 10,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    speedup_factor,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    finance_team_hours_saved_monthly: hours_saved_monthly,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    estimated_monthly_labor_cost_saved_usd: monthly_labor_saved,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
