  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { Play, Sparkles, FileSpreadsheet, FileCode, Check, RefreshCw, UploadCloud } from \'lucide-react\';\n\ninterface CloseGoalInputProps {\n  goal: string;\n  onGoalChange: (goal: string) => void;\n  period: string;\n  onPeriodChange: (period: string) => void;\n  onRunClose: () => void;\n  isRunning: boolean;\n}\n\nexport const CloseGoalInput: React.FC<CloseGoalInputProps> = ({\n  goal,\n  onGoalChange,\n  period,\n  onPeriodChange,\n  onRunClose,\n  isRunning,\n}) => {\n  const [activePreset, setActivePreset] = useState<number>(0);\n\n  const presets = [\n    {\n      title: \'Q3 2026 Full Close + Board Deck\',\n      period: \'Q3 2026\',\n      prompt: \'Execute full Q3 2026 financial close across Stripe, NetSuite GL, and SVB operating accounts. Calculate ASC 606 ratable revenue waterfall, flag budget variances >10%, verify zero suspense balance, and synthesize a one-page board summary memo.\',\n    },\n    {\n      title: \'Flash Month-End & GPU Cost Variance\',\n      period: \'Sept 2026\',\n      prompt: \'Perform flash month-end close for September 2026. Audit AWS and CoreWeave GPU inference billings against customer consumption tiers, ensure gross margin exceeds 80%, and reconcile Brex executive corporate cards.\',\n    },\n    {\n      title: \'Pre-Audit Year-to-Date Tie-Out\',\n      period: \'FY 2026 YTD\',\n      prompt: \'Reconcile all bank depository accounts against NetSuite General Ledger through Q3. Verify 100% debit/credit mathematical footing, zero unallocated receipts, and generate PwC external audit tie-out binder.\',\n    },\n  ];\n\n  const handleSelectPreset = (idx: number) => {\n    setActivePreset(idx);\n    onPeriodChange(presets[idx].period);\n    onGoalChange(presets[idx].prompt);\n  };\n\n  return (\n    <div className=\"bg-[#0f131c] border border-neutral-800 rounded-lg p-5 mb-6\">\n      {/* Header bar with period selector & preset pills */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3\">\n        <div className=\"flex items-center gap-2\">\n          <span className=\"text-xs font-semibold text-slate-200\">Outcome Specification</span>\n          <span className=\"text-slate-500 text-xs\">\302\267</span>\n          <span className=\"text-xs text-slate-400\">Describe the objective once, agent executes the close</span>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          <label className=\"text-[11px] text-slate-400 font-mono\">Period:</label>\n          <input\n            type=\"text\"\n            value={period}\n            onChange={(e) => onPeriodChange(e.target.value)}\n            disabled={isRunning}\n            className=\"bg-[#141923] border border-neutral-800 text-slate-200 text-xs font-mono px-2.5 py-1 rounded focus:outline-none focus:border-emerald-500 w-24 text-center\"\n          />\n        </div>\n      </div>\n\n      {/* Preset Buttons */}\n      <div className=\"flex flex-wrap items-center gap-1.5 mb-3\">\n        <span className=\"text-[11px] text-slate-400 mr-1\">Presets:</span>\n        {presets.map((p, idx) => (\n          <button\n            key={idx}\n            onClick={() => handleSelectPreset(idx)}\n            disabled={isRunning}\n            className={`text-xs px-2.5 py-1 rounded transition-colors ${\n              activePreset === idx\n                ? \'bg-emerald-950/70 border border-emerald-700/60 text-emerald-300 font-medium\'\n                : \'bg-[#141923] border border-neutral-800 text-slate-400 hover:text-slate-200\'\n            }`}\n          >\n            {p.title}\n          </button>\n        ))}\n      </div>\n\n      {/* Main Goal Prompt Textarea */}\n      <div className=\"relative mb-4\">\n        <textarea\n          rows={3}\n          value={goal}\n          onChange={(e) => onGoalChange(e.target.value)}\n          disabled={isRunning}\n          placeholder=\"State the outcome you want CloseRun to accomplish...\"\n          className=\"w-full bg-[#121622] border border-neutral-800 rounded-md p-3 text-xs md:text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-emerald-500/70 font-sans leading-relaxed resize-none\"\n        />\n      </div>\n\n      {/* Connected Source Files Grid */}\n      <div className=\"pt-2 border-t border-neutral-800/80 mb-4\">\n        <div className=\"text-[11px] text-slate-400 mb-2 flex items-center justify-between\">\n          <span>Connected Sources & Ingestion Queue (4 Sources Ready)</span>\n          <span className=\"text-emerald-400 font-mono text-[10px]\">Encrypted & Sandboxed</span>\n        </div>\n        \n        <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs\">\n          <div className=\"bg-[#141923] border border-neutral-800/80 rounded p-2 flex items-center gap-2\">\n            <FileSpreadsheet className=\"w-4 h-4 text-emerald-400 shrink-0\" />\n            <div className=\"truncate\">\n              <div className=\"font-medium text-slate-200 truncate\">Stripe_Payouts_Q3.csv</div>\n              <div className=\"text-[10px] text-slate-500 font-mono\">1.42 MB \302\267 4,892 items</div>\n            </div>\n          </div>\n\n          <div className=\"bg-[#141923] border border-neutral-800/80 rounded p-2 flex items-center gap-2\">\n            <FileSpreadsheet className=\"w-4 h-4 text-cyan-400 shrink-0\" />\n            <div className=\"truncate\">\n              <div className=\"font-medium text-slate-200 truncate\">NetSuite_GL_Q3.csv</div>\n              <div className=\"text-[10px] text-slate-500 font-mono\">3.10 MB \302\267 5,128 records</div>\n            </div>\n          </div>\n\n          <div className=\"bg-[#141923] border border-neutral-800/80 rounded p-2 flex items-center gap-2\">\n            <FileCode className=\"w-4 h-4 text-amber-400 shrink-0\" />\n            <div className=\"truncate\">\n              <div className=\"font-medium text-slate-200 truncate\">SVB_Operating.pdf</div>\n              <div className=\"text-[10px] text-slate-500 font-mono\">890 KB \302\267 Bank OCR</div>\n            </div>\n          </div>\n\n          <div className=\"bg-[#141923] border border-neutral-800/80 rounded p-2 flex items-center gap-2\">\n            <FileSpreadsheet className=\"w-4 h-4 text-purple-400 shrink-0\" />\n            <div className=\"truncate\">\n              <div className=\"font-medium text-slate-200 truncate\">Brex_CorpExpenses.csv</div>\n              <div className=\"text-[10px] text-slate-500 font-mono\">450 KB \302\267 612 receipts</div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Action Footer */}\n      <div className=\"flex flex-col sm:flex-row items-center justify-between gap-3 pt-3 border-t border-neutral-800/80\">\n        <div className=\"flex items-center gap-2 text-xs text-slate-400\">\n          <Sparkles className=\"w-3.5 h-3.5 text-emerald-400\" />\n          <span>Pay-per-outcome: <strong>$1,250</strong> charged only upon certified close</span>\n        </div>\n\n        <button\n          onClick={onRunClose}\n          disabled={isRunning}\n          className={`w-full sm:w-auto px-6 py-2.5 rounded-md text-xs font-semibold flex items-center justify-center gap-2 transition-all ${\n            isRunning\n              ? \'bg-neutral-800 text-slate-400 cursor-not-allowed\'\n              : \'bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-bold shadow-lg shadow-emerald-500/10\'\n          }`}\n        >\n          {isRunning ? (\n            <>\n              <RefreshCw className=\"w-3.5 h-3.5 animate-spin\" />\n              <span>Executing Autonomous Close...</span>\n            </>\n          ) : (\n            <>\n              <Play className=\"w-3.5 h-3.5 fill-current\" />\n              <span>Run Autonomous Close</span>\n            </>\n          )}\n        </button>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/CloseGoalInput.tsx"
        }
        overwrite: true
      }
    }
