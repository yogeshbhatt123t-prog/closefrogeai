            }
            lines {
              text: "-- Enable necessary extensions"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE EXTENSION IF NOT EXISTS \"uuid-ossp\";"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE EXTENSION IF NOT EXISTS \"pgcrypto\";"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE EXTENSION IF NOT EXISTS \"vector\";"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
