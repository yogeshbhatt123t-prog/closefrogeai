            }
            lines {
              text: "      setDemoStep(2);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      handleRunClose();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    } else if (demoStep === 2) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
