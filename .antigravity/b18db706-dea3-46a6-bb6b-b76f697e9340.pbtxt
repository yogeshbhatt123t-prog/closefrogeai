              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                  Every run creates an immutable snapshot. If the controller disagrees with any batch reconciliation, they can revert the state to the pre-close baseline instantly."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                </p>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
