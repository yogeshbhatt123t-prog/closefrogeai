          replacement_content: "    setAuditLogs(prev => [auditEntry, ...prev]);\n  };\n\n  // Batch approve all pending exceptions\n  const handleApproveAllExceptions = () => {\n    const pendingCount = exceptions.filter(e => !e.resolved).length;\n    if (pendingCount === 0) return;\n\n    setExceptions(prev => prev.map(exc => ({\n      ...exc,\n      resolved: true,\n      resolution_note: \'Bulk approved by controller via automated suggestion verification\'\n    })));\n\n    setOutcomeScore(prev => Math.min(100, prev + (pendingCount * 1.2)));\n\n    const auditEntry: AuditLogEntry = {\n      id: `log_bulk_exc_${Date.now()}`,\n      timestamp: new Date().toISOString(),\n      actor: \'user\',\n      action: \'BULK_EXCEPTIONS_APPROVED\',\n      details: `Bulk approved by controller via automated suggestion verification (${pendingCount} exceptions cleared). Debits and credits tied out.`,\n      hash: \'8f96e081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00b22\'\n    };\n    setAuditLogs(prev => [auditEntry, ...prev]);\n  };"
