              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              <div>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                <h4 className=\"font-bold text-white text-sm mb-1\">8. Traction & The Ask</h4>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
