      thinking_signature: "\022\251\016\n\246\016\001i\024}\023j\256-Cd0\244\\N\024\331nI+b\271\nm\244G\242\230a\366\255\263\023\270\a\213\375\367Z-5\300\231g^\335\206\237e8\355ajAJ\213\024\243\001o\341Y\225\217\253^+\316\271W5p9\356\246\b\207\342\275\305|$W\251v\367sG_W\326w\352:\3308\303*\322i\016\340\034\323\325\307H\344fp\330\3327;7\030t\237\251\006\'$\204\334\324F\327KT.\366\206\024\265pJH\367\236@\346r\022\023\2330c\335;%U\217\332*6\000V\024\000\"\023\353\332\0342\357y\345\343\356\215D\366H\300\020@\315u\221>\f\370\376\\\242\256fp\n\302\367\037@\226\276\033\2752\255\0062\333\224\207\202)\247\310}\267\022D\003;\2518\027r\027\232\237aa\300d\276\254T\335m\324bq\213\240_\313\306\366\221.\340?\376o\365\346H\201_%\327Lel\321h\314]\335\033\347Z:@NB\223\223T\273\326\002\257\230u\030\266N\327\211\371\2108{f\b\351t\177\a\36793:\225\243\237\343|D\341\203\002\214\362\364<\225\004\204_\342\335\233\352\270Z\271E\227\372\204d\376\v}$\271\344\275\334=\336\003\nT}AC\177/(\361\a\031<\301\357\267\263\a\244F\363=\016.\002\306\002\272\322^P\265\343R\243\367\305\341\301\307\371\321c\027:_s\006\213\021\232M\377\230S(s4\240\252\024\037\327\333Id\247\023LC\353Y\262\350Q\315\311\035\245\377-\360\177g|\002\202vD\210:\330\347\272\373\251\021\004zB\211tVn\314\267\016\265\347\2571a\0218\253\217\036SL\356\254\035\266?\"&\360{x=\305\004\300\220\355C\037\bq\247q\2137\323\371<\327Ad\036c\263K\253\203\037\312\231\366\004r\254\205\264\335d\356o\033a#G\021\327\217*\203?\321/\330\317\216\004\034I\246\3347\214\000\255\316p\326j\231W1\304\367\220Y\353=\244\220\020\363R\373\b%\272\033\262\257\315e\323\222\202\022\024\241\357\'\267Q\237\352\277;\201\364\022\270\232\'\n\224\201\270\032\233\236\3514I \323-\267Aa\300\204\343Hdq0\nxk\332\371L\205\005\334G<m\'.X0\222\356Uh\016@a/?D_\260B\275\362|{\276i^\330\347\"\v\321\263\375\203Bp(\251)\315{\177\210\354\314\0053\002\201\235\206\226\341\357l\200h\274\354]\260 \205GF\353\201\210\344\212m(\267\333I\004\036*_@~\t1\320F\205=\316\374\020\220\321\366\237\325z3\345\201\243\341\223/\326sr\365:\005\354\v\330\373\356*\3127i\222rf\363\002\033)\266B\004*\217\021\305\315\bf\nS\224$\347\252-\332CM\375\345\340\367\353u\016c\024,L\373JG#\370U\320\020\r\241?P\220\2072t/n\236_\241\345?n\312`q\346\271\234#\307Z\302y3#\006\2311\020+\254X!\037\263\256\320d\336\002\202\340\366b\2056\311\020\376\277-\226\355\231C\234\036\315^\307`\215\221\374\034\352\030d\273\231\217\022+\215\211A\256\240\266\000\237\363$b\320\226\214\022\025\005\021fW-\215\341\307Pn\222\254@\326%\354\002\266\330g#\342\241G\336e\241\023\3061\211\336s\266B\230R\3001\231Q\342\032\322@\216u\357OR\r\347\324\215O\037P\251 \224a\355J \020\004W\316\237\313\r\234\370\200)\242R\340\304{\321\234\033\264\347j\031k\220@iR\tM\024\177\016\006t\'\3762\307\303_3-wX\202\234\246<\336\364.\226\327?@\005[\004\004\224\235\244n\270\a\277\233\343\004\004\017\261Hq\035[\313\0359\211\220N\246\254_\347\346B\324\017\277\f\266\202\341\236\034l<\016\271n1\2100\342\be\346,\021!\247\315\342\267l\346#v\244Vs\257\241\236Q6\f\301\236\204\234\033E\3239n\357\24317\325\212_\337\a\306Aj\304J\207VP1\270\b5\024$\257\177G3\243_$N\3725\261\242\323\2654i\031J\230\vp_\361\3550\346\331\364\372\343\256\342\276\024)\205Z\377\330t\rt\3428\237o\'G\271_\235aEn\266\375h\340\232\a\177\204w;?\017\240*\225\215\242\310\316\312\245\027\276c,\251\0241-$+6$0\345\031\v\310\035\270\351\211\223\357-\361\'\257\r\261_G.{\020\211q\r1X\3524\036E\271\337D*H\031O\321\220`PT\372b\177\0069\352\364\262\335qV\350\325S\331\262\317\217/M+\377WJ:\033\301\227\276>..\327\267\\Ip\332j\271\005{\351\206\226\257\3376\343\353\306\025\354\f\207\312A?K\305\232\346\ff\322\t`\267\fL\252I\306V\000\246v\366JX\201f\0179\256\256\206Be\b\321\367\340\033\262\350^l\ai\362\213&\350\315\024\363\364\037G\2560tR\222\260\n\244\026\252\302\241q$v\027\304n7^\t\005Q\205\204\234bys\241\003\245`\254\305\001\343M\377oQ;\345\021&\330W\231\2264\315\345\022\310\204d\373\021\023)MB\221&F3\275\310\272T4^\376\243\357/\375\277,g\veW\375\323\224\030\002\311\340\017\334\331\277\227