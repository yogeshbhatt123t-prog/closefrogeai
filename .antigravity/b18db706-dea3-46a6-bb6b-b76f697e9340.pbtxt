            lines {
              text: "                <pre className=\"text-slate-300 text-[11px] overflow-x-auto leading-relaxed\">"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "{`CREATE TABLE knowledge_base ("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
