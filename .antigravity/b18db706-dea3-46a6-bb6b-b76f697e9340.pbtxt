              text: "            <div className=\"prose prose-invert prose-xs text-slate-200 leading-relaxed space-y-4 font-sans text-xs sm:text-sm\">"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              <h3 className=\"text-white text-sm font-bold\">1. Executive Summary & Revenue Milestones</h3>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              <p>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                CloudScale delivered solid capital efficiency in {sharedFinancialData.period}. Recognized GAAP Net Revenue reached <strong>${(sharedFinancialData.revenue.total / 1000000).toFixed(2)}M</strong>, representing an Annual Recurring Revenue (ARR) run-rate of <strong>${(sharedFinancialData.arr / 1000000).toFixed(2)}M</strong> (calculated as MRR of ${(sharedFinancialData.mrr / 1000).toFixed(0)}k \303\227 12)."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                Operating Income reached positive <strong>+${(sharedFinancialData.operating_income / 1000).toFixed(0)}k</strong> (GAAP Net Income of +${(sharedFinancialData.net_income / 1000).toFixed(0)}k). Cash and short-term equivalents at SVB stand at <strong>${(sharedFinancialData.cash_balance / 1000000).toFixed(2)}M</strong>, providing <strong>{sharedFinancialData.runway_months.toFixed(1)} months of cash runway</strong> based on quarterly net burn of ${(sharedFinancialData.quarterly_net_burn / 1000).toFixed(0)}k."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              </p>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              <h3 className=\"text-white text-sm font-bold\">2. Accounting Correctness (ASC 606 & ASC 340-40 Treatment)</h3>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              <p>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                - <strong>Revenue Recognition (ASC 606):</strong> Subscription revenue of ${(sharedFinancialData.revenue.subscription_recognized / 1000000).toFixed(2)}M is recognized ratably over active subscription contract terms. Usage telemetry revenue of ${(sharedFinancialData.revenue.usage_telemetry / 1000).toFixed(0)}k was billed and recognized in arrears for Q3 consumption.<br />"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                - <strong>Sales Commission Capitalization (ASC 340-40):</strong> Cash sales commission payouts totaled $495,000 for Q3. Under ASC 340-40 (Contracts with Customers - Cost Capitalization), these qualifying incremental contract acquisition costs are capitalized to the Balance Sheet and amortized ratably over the 36-month estimated customer contract life. Q3 commission amortization expensed to Sales & Marketing was $41,250, resulting in ending capitalized contract cost assets of $773,750 on the Balance Sheet."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              </p>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              <h3 className=\"text-white text-sm font-bold\">3. Material Budget Variances</h3>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              <p>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                - <strong>Subscription Revenue:</strong> Favorable variance of +$250k (+4.4%) driven by accelerated mid-market renewals (NDR: 118.2%).<br />"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                - <strong>Cloud Hosting & GPUs:</strong> Unfavorable variance of +$57.5k (+20.2%) in AWS and CoreWeave clusters caused by inference spikes on enterprise customer endpoints (fully offset by +$84k usage revenue).<br />"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                - <strong>Legal & Compliance:</strong> Favorable variance of -$23k (-17.0%) resulting from automated trial balance reconciliation reducing manual audit prep hours."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              </p>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
