              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    stripe_charge_id VARCHAR(255),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    idempotency_key VARCHAR(255) NOT NULL UNIQUE,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
