    content: "import React, { useState, useId } from \'react\';\nimport {\n  Play,\n  CheckCircle2,\n  AlertTriangle,\n  Clock,\n  DollarSign,\n  TrendingUp,\n  TrendingDown,\n  Shield,\n  FileSpreadsheet,\n  FileCode,\n  Sparkles,\n  Download,\n  Copy,\n  Check,\n  RefreshCw,\n  Terminal,\n  Database,\n  FileText,\n  Filter,\n  ArrowUpRight,\n  ArrowDownRight,\n  ChevronDown,\n  ChevronUp,\n  Cpu,\n  Layers,\n  Lock,\n  ExternalLink,\n  Info,\n  X,\n  BarChart3,\n  Upload,\n  AlertCircle,\n  HelpCircle,\n  Users,\n  Briefcase,\n  History,\n  Calculator,\n  RotateCcw,\n  Sliders,\n  CheckSquare,\n  Table,\n  Eye\n} from \'lucide-react\';\nimport {\n  BarChart,\n  Bar,\n  XAxis,\n  YAxis,\n  CartesianGrid,\n  Tooltip,\n  Legend,\n  ResponsiveContainer\n} from \'recharts\';\nimport { AuthProvider, useAuth, UserRole } from \'./context/AuthContext\';\nimport { OnboardingTour } from \'./components/OnboardingTour\';\n\n// --- TYPES ---\nexport type CloseJobStatus =\n  | \'idle\'\n  | \'planning\'\n  | \'gathering\'\n  | \'reconciling\'\n  | \'analyzing_variance\'\n  | \'drafting_package\'\n  | \'self_critiquing\'\n  | \'completed\';\n\nexport type { UserRole };\n\nexport interface DeterministicCheckResult {\n  id: string;\n  name: string;\n  description: string;\n  evaluated_formula: string;\n  left_val: number;\n  right_val: number;\n  delta: number;\n  passed: boolean;\n  notes: string;\n}\n\nexport interface VarianceItem {\n  id: string;\n  account_code: string;\n  account_name: string;\n  category: \'Revenue\' | \'COGS\' | \'R&D\' | \'S&M\' | \'G&A\';\n  actual_amount: number;\n  budget_amount: number;\n  prior_amount: number;\n  variance_amount: number;\n  variance_pct: number;\n  trend_pct: number;\n  trend_favorable: boolean;\n  trend_label: string;\n  materiality: \'high\' | \'medium\' | \'low\';\n  ai_analysis: string;\n}\n\nexport interface ExceptionItem {\n  id: string;\n  title: string;\n  source: \'Stripe\' | \'Silicon Valley Bank\' | \'Brex\' | \'NetSuite\';\n  amount: number;\n  confidence: number;\n  detected_anomaly: string;\n  suggested_action: string;\n  resolved: boolean;\n  rejected: boolean;\n  resolution_note?: string;\n  resolved_by?: string;\n}\n\nexport interface AuditLogEntry {\n  id: string;\n  timestamp: string;\n  actor: \'agent\' | \'user\' | \'system\';\n  action: string;\n  input_data?: string;"
